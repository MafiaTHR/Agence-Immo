# URL du webhook Discord utilisée par la route API /api/order (Vercel).
# Ne JAMAIS commiter la vraie valeur : configurez-la dans les variables
# d'environnement de votre projet Vercel (Settings > Environment Variables).
# Ce fichier .env.example sert uniquement de modèle.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/VOTRE_ID/VOTRE_TOKEN
